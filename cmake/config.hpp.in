#pragma once

#include "kh/export.hpp" // IWYU pragma: export

#cmakedefine KH_USES_QT 1
#cmakedefine KH_USES_FMT 1
#cmakedefine KH_USE_128BIT_TYPES 1
#cmakedefine KH_NO_EXCEPTIONS 1
#cmakedefine KH_NO_BADALLOC 1
#cmakedefine KH_INCLUDE_ARG_PARSER 1
#cmakedefine KH_INCLUDE_FILESYSTEM 1
#cmakedefine KH_INCLUDE_MD5HASH 1
#cmakedefine KH_INCLUDE_TASK_SYSTEM 1
#cmakedefine KH_INCLUDE_TERMINAL_PRINT 1
#cmakedefine KH_INCLUDE_TOML 1
#cmakedefine KH_MUST_HAVE_16_32_64 1
#cmakedefine KH_MUST_HAVE_32_64 1
#cmakedefine KH_MUST_HAVE_16BIT_TYPES 1
#cmakedefine KH_MUST_HAVE_32BIT_TYPES 1
#cmakedefine KH_MUST_HAVE_64BIT_TYPES 1
#cmakedefine KH_OVERRIDE_PLATFORM_SAFETY 1
#cmakedefine KH_CLANG_GNUC_COMPATIBLE 1

#cmakedefine KH_KERNEL_VERSION "@KH_KERNEL_VERSION@"

#define KH_COMPILED_WITH_@KH_COMPILER_SHORTNAME@ @KH_COMPILER_VERSION@
#define KH_COMPILER_DISPLAY_STRING "@KH_COMPILER_NAME@ @CMAKE_CXX_COMPILER_VERSION@"

#ifdef KH_COMPILED_WITH_MSVC
# ifdef KH_USES_FMT
#  define _SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING // This quiets a deprecation warning in {fmt} version 10.
# endif
# ifdef libKirHut_EXPORTS
#  define KH_EXPLICIT_TEMPLATE_EXPORT
#  define KH_EXPLICIT_TEMPLATE_INSTANCE KH_EXPORT
# else
#  define KH_EXPLICIT_TEMPLATE_EXPORT KH_EXPORT
#  define KH_EXPLICIT_TEMPLATE_INSTANCE
# endif
#else
# define KH_EXPLICIT_TEMPLATE_EXPORT KH_EXPORT
# define KH_EXPLICIT_TEMPLATE_INSTANCE
#endif
