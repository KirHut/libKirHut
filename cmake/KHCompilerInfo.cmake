function(kh_find_compiler_info)
    string(REGEX MATCH "^[0-9]+(\\.[0-9]+)?" var_COMPILER_VERSION_CLEAN "${CMAKE_CXX_COMPILER_VERSION}")
    string(REPLACE "." ";" var_COMPILER_VERSION_LIST "${var_COMPILER_VERSION_CLEAN}")

    list(GET var_COMPILER_VERSION_LIST 0 var_COMPILER_VERSION_MAJOR)
    list(GET var_COMPILER_VERSION_LIST 1 var_COMPILER_VERSION_MINOR)

    string(REGEX REPLACE "^0+" "" var_COMPILER_VERSION_MAJOR "${var_COMPILER_VERSION_MAJOR}")
    string(REGEX REPLACE "^0+" "" var_COMPILER_VERSION_MINOR "${var_COMPILER_VERSION_MINOR}")

    if(var_COMPILER_VERSION_MAJOR STREQUAL "")
        set(var_COMPILER_VERSION_MAJOR 0)
    endif()
    if(var_COMPILER_VERSION_MINOR STREQUAL "")
        set(var_COMPILER_VERSION_MINOR 0)
    endif()

    math(EXPR var_COMPILER_VERSION_NUMBER
        "${var_COMPILER_VERSION_MAJOR} * 100 + ${var_COMPILER_VERSION_MINOR}"
    )

    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        set(KH_COMPILER_SHORTNAME "GCC")
        set(KH_COMPILER_NAME "GNU C++ Compiler")
        set(KH_CLANG_GNUC_COMPATIBLE YES)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        set(KH_COMPILER_SHORTNAME "CLANG")
        set(KH_COMPILER_NAME "LLVM Clang Compiler")
        set(KH_CLANG_GNUC_COMPATIBLE YES)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
        set(KH_COMPILER_SHORTNAME "APPLECLANG")
        set(KH_COMPILER_NAME "Apple Clang Compiler")
        set(KH_CLANG_GNUC_COMPATIBLE YES)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        set(KH_COMPILER_SHORTNAME "MSVC")
        set(KH_COMPILER_NAME "Microsoft Visual C++ Compiler")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "IntelLLVM")
        set(KH_COMPILER_SHORTNAME "ICX")
        set(KH_COMPILER_NAME "Intel oneAPI DPC++/C++ Compiler")
        set(KH_CLANG_GNUC_COMPATIBLE YES)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "NVHPC")
        set(KH_COMPILER_SHORTNAME "NVHPC")
        set(KH_COMPILER_NAME "NVidia HPC SDK")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "NVIDIA")
        set(KH_COMPILER_SHORTNAME "NVIDIA")
        set(KH_COMPILER_NAME "NVidia CUDA C++ Compiler")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "XLClang")
        set(KH_COMPILER_SHORTNAME "IBMXL")
        set(KH_COMPILER_NAME "IBM Open XL C++ Compiler")
        set(KH_CLANG_GNUC_COMPATIBLE YES)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "ARMClang")
        set(KH_COMPILER_SHORTNAME "ARMCLANG")
        set(KH_COMPILER_NAME "ARMClang Compiler")
        set(KH_CLANG_GNUC_COMPATIBLE YES)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "CrayClang")
        set(KH_COMPILER_SHORTNAME "CRAY")
        set(KH_COMPILER_NAME "Cray CCE LLVM Compiler")
        set(KH_CLANG_GNUC_COMPATIBLE YES)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "QCC")
        set(KH_COMPILER_SHORTNAME "QNX")
        set(KH_COMPILER_NAME "BlackBerry QNX C++ Compiler")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Diab")
        set(KH_COMPILER_SHORTNAME "DIAB")
        set(KH_COMPILER_NAME "Wind River Systems Diab Compiler")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GHS")
        set(KH_COMPILER_SHORTNAME "GHS")
        set(KH_COMPILER_NAME "Green Hills Software C++ Compiler")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "LCC")
        set(KH_COMPILER_SHORTNAME "MCST")
        set(KH_COMPILER_NAME "MCST Elbrus C++ Compiler")
    else()
        set(KH_COMPILER_SHORTNAME "UNKNOWN")
        set(KH_COMPILER_NAME "Unknown C++ Compiler")
    endif()

    set(KH_COMPILER_SHORTNAME ${KH_COMPILER_SHORTNAME} PARENT_SCOPE)
    set(KH_COMPILER_NAME "${KH_COMPILER_NAME}" PARENT_SCOPE)
    set(KH_COMPILER_VERSION ${var_COMPILER_VERSION_NUMBER} PARENT_SCOPE)

    if(KH_CLANG_GNUC_COMPATIBLE)
        set(KH_CLANG_GNUC_COMPATIBLE YES PARENT_SCOPE)
    endif()
endfunction()
